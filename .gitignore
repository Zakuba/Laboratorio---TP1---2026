# Unity project is located in "Labo TP 1/"
#
# This .gitignore is placed at the root of the Git repository.
# Unity project:
#   Labo TP 1/
#
# Based on:
# https://github.com/github/gitignore/blob/main/Unity.gitignore

# Unity generated folders
Labo TP 1/[Ll]ibrary/
Labo TP 1/[Tt]emp/
Labo TP 1/[Oo]bj/
Labo TP 1/[Bb]uild/
Labo TP 1/[Bb]uilds/
Labo TP 1/[Ll]ogs/
Labo TP 1/[Uu]ser[Ss]ettings/

# Unity temporary files
Labo TP 1/.utmp/
*.log

# Blender
*.blend1
*.blend1.meta

# MemoryCaptures can get excessive in size
Labo TP 1/[Mm]emoryCaptures/

# Recordings can get excessive in size
Labo TP 1/[Rr]ecordings/

# Asset Store Tools
# Labo TP 1/[Aa]ssets/AssetStoreTools*

# Autogenerated JetBrains Rider plugin
Labo TP 1/[Aa]ssets/Plugins/Editor/JetBrains*

# JetBrains Rider personal-layer settings
*.DotSettings.user

# Visual Studio cache directory
.vs/
Labo TP 1/.vs/

# Gradle cache directory
.gradle/
Labo TP 1/.gradle/

# Autogenerated VS/MD/Consulo solution and project files
Labo TP 1/ExportedObj/
Labo TP 1/.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity crash reports
Labo TP 1/sysinfo.txt

# Mono crash reports
mono_crash.*

# Builds
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics generated file
crashlytics-build.properties

# TestRunner generated files
Labo TP 1/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# Addressables
Labo TP 1/ServerData/
Labo TP 1/[Aa]ssets/StreamingAssets/aa*
Labo TP 1/[Aa]ssets/AddressableAssetsData/link.xml*
Labo TP 1/[Aa]ssets/Addressables_Temp*
Labo TP 1/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting auto-generated files
Labo TP 1/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
Labo TP 1/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
Labo TP 1/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
Labo TP 1/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Auto-generated scenes by play mode tests
Labo TP 1/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# Auto-generated cache in Assets folder
Labo TP 1/[Aa]ssets/[Ss]ceneDependencyCache*